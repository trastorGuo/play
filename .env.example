# ===========================================
# 环境变量配置示例文件
# 复制此文件为 .env 并填入真实的配置信息
# ===========================================

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password
DB_DATABASE=play

# 服务器配置
SERVER_PORT=6015

# 部署配置
DEPLOY_HOST=your_server_ip
DEPLOY_USER=your_deploy_username
DEPLOY_PATH=/path/to/deploy

# Redis配置（如果需要）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 环境标识
NODE_ENV=development

# API v2（必须使用随机高熵值，生产环境不可留空）
V2_TOKEN_SECRET=replace_with_at_least_32_random_bytes
WECHAT_IDENTITY_PEPPER=replace_with_at_least_32_random_bytes
V2_JOIN_CODE_PEPPER=replace_with_at_least_32_random_bytes
V2_JOIN_CODE_ENCRYPTION_KEY=replace_with_base64_encoded_32_random_bytes
V2_FEEDBACK_UPLOAD_DIR=./storage/feedback-images
V2_PROFILE_AVATAR_DIR=./storage/profile-avatars
WECHAT_APP_ID=your_wechat_mini_program_appid
WECHAT_APP_SECRET=your_wechat_mini_program_secret
PUBLIC_API_BASE_URL=https://your-domain.example/api/v2
V2_AUTH_MOCK=true
V2_REALTIME_MEMORY_FALLBACK=true
DB_SYNCHRONIZE_LEGACY=false
DB_MIGRATIONS_RUN=false
DB_LOGGING=false
