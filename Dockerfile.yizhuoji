FROM node:22-alpine

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

# TypeScript is compiled with `npm run build:server` before building the image.
# Keep v2 migrations inside the image; never run them implicitly at startup.
COPY server/ ./dist/
RUN mkdir -p /app/storage/feedback-images /app/storage/profile-avatars

ENV NODE_ENV=production
EXPOSE 6015
CMD ["node", "dist/main.js"]
